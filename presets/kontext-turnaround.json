  {
   "node": "61",
   "input": "text",
   "template": "{subject}, front view, the whole object centered in frame, straight orthographic view, flat even lighting, pure white background, clean game asset concept art, exactly one single item, no other objects, no text, no labels, no shadows"
  },
  {
   "node": "10",
   "input": "text",
   "template": "This picture shows {subject}. Show this exact same object in a left side view (we see the object's left side, camera turned 90 degrees). Full object in frame, straight orthographic view, flat even lighting, pure white background. Keep the identical design, shapes, colors, materials and proportions. Exactly one item, no other objects, no text, no labels, no arrows, no shadows."
  },
  {
   "node": "20",
   "input": "text",
   "template": "This picture shows {subject}. Show this exact same object in a back view (camera directly behind it). Full object in frame, straight orthographic view, flat even lighting, pure white background. Keep the identical design, shapes, colors, materials and proportions. Exactly one item, no other objects, no text, no labels, no arrows, no shadows."
  },
  {
   "node": "30",
   "input": "text",
